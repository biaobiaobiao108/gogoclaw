{
  "name": "gogoclaw-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --no-orphans ./scripts/dev.ts",
    "build": "bun ./scripts/build.ts && bun check -b",
    "build:backend": "bun ./scripts/build.ts --backend && bun check -b",
    "preview": "bun ./scripts/preview.ts",
    "routes": "tsr generate",
    "routes:watch": "tsr watch",
    "css": "tailwindcss -i ./src/index.css -o ./.cache/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./src/index.css -o ./.cache/tailwind.css --watch",
    "test": "bun test",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "clean": "bun ./scripts/clean.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "jotai": "^3.0.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/router-cli": "^1.168.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "minimatch": "11.0.1",
    "postcss-selector-parser": "7.2.0"
  }
}
