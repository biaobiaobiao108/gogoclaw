{
  "name": "gogoclaw-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build && bun check -b",
    "build:backend": "bun --bun vite build --outDir ../backend/dist --emptyOutDir && bun check -b && bun ./scripts/ensure-backend-gitkeep.ts",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "jotai": "^3.0.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
